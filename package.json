{
  "name": "bat-con-vat-gesture",
  "private": true,
  "version": "1.0.0",
  "description": "Tro choi bat con vat bang cu chi tay qua webcam, chay 100% tren trinh duyet",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-models.mjs",
    "sync-assets": "node scripts/sync-assets.mjs",
    "predev": "npm run setup && npm run sync-assets",
    "dev": "vite",
    "prebuild": "npm run setup && npm run sync-assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "qrcode-terminal": "0.12.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
